{
    "name": "windy-plugin-abaco-de-harrison",
    "version": "1.0.2",
    "description": "Diagnóstico de viento Zonda con el Ábaco de Harrison",
    "main": "dist/plugin.min.js",
    "type": "module",
    "packageManager": "npm@10.9.2",
    "scripts": {
        "build": "rm -rf dist && mkdir dist && SERVE=false rollup -c && cp package.json dist/",
        "start": "rollup -w -c",
        "typecheck": "svelte-check --tsconfig ./tsconfig.json",
        "test": "vitest run",
        "check:dist": "node scripts/check-dist.mjs",
        "verify": "npm run typecheck && npm test && npm run build && npm run check:dist"
    },
    "author": {
        "name": "Francisco J. Ramos Francés",
        "email": "fcoramos@gmail.com",
        "url": "https://github.com/fcoramos"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/fcoramos/windy-plugin-abaco-de-harrison.git"
    },
    "license": "ISC",
    "devDependencies": {
        "@types/d3": "^7.4.3",
        "@windycom/plugin-devtools": "^3.0.3",
        "d3": "^7.9.0",
        "svelte": "4.2.20",
        "svelte-check": "^4.7.4",
        "typescript": "5.9.3",
        "vitest": "^4.1.10"
    }
}
